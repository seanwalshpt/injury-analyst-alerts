{
  "_how_to_edit": "Tuning knobs for the monitor. Safe to change numbers here without touching the Python code.",

  "alert_threshold": 60,
  "high_priority_threshold": 80,

  "max_story_age_hours": 3,
  "story_merge_window_hours": 36,
  "storyline_window_days": 30,
  "buzz_window_hours": 6,
  "storyline_heat_hours": 72,
  "update_cooldown_minutes": 30,
  "max_updates_per_story": 8,

  "live_mode": {
    "_note": "When ESPN's scoreboard shows a game in progress (or starting/just ended), each run keeps re-checking that league's in-game searches every poll_seconds until the next scheduled run. Set enabled to false to turn this off.",
    "enabled": true,
    "poll_seconds": 60,
    "loop_seconds": 240,
    "pregame_minutes": 90,
    "postgame_minutes": 60,
    "game_hours": {"nfl": 3.5, "nba": 2.5, "mlb": 3.0, "nhl": 2.75, "soccer": 2.0},
    "scoreboards": {
      "nfl": ["https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard"],
      "nba": ["https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard"],
      "mlb": ["https://site.api.espn.com/apis/site/v2/sports/baseball/mlb/scoreboard"],
      "nhl": ["https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard"],
      "soccer": [
        "https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard",
        "https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard",
        "https://site.api.espn.com/apis/site/v2/sports/soccer/esp.1/scoreboard",
        "https://site.api.espn.com/apis/site/v2/sports/soccer/usa.1/scoreboard"
      ]
    },
    "live_queries": {
      "nfl": ["NFL injury", "NFL \"carted off\"", "NFL \"won't return\" OR \"will not return\" OR \"questionable to return\"", "quarterback injury", "NFL \"locker room\" OR \"blue tent\""],
      "nba": ["NBA injury", "NBA \"won't return\" OR \"will not return\" OR \"questionable to return\"", "NBA \"locker room\" OR \"went down\""],
      "mlb": ["MLB injury", "MLB \"left the game\" OR \"exits\""],
      "nhl": ["NHL injury", "NHL \"won't return\" OR \"will not return\""],
      "soccer": ["\"Premier League\" injury", "\"Champions League\" injury", "\"MLS\" injury"]
    }
  },

  "quiet_hours": {
    "_note": "Overnight (Eastern time) with no games on, run a full sweep only every sweep_every_minutes instead of every 5.",
    "start_hour_et": 2,
    "end_hour_et": 7,
    "sweep_every_minutes": 15
  },

  "league_multiplier": {
    "nfl": 1.0,
    "nba": 1.0,
    "mlb": 0.85,
    "nhl": 0.8,
    "soccer": 0.8
  },

  "google_news_queries": {
    "nfl": [
      "NFL injury",
      "NFL \"carted off\"",
      "NFL \"ruled out\"",
      "NFL \"won't return\" OR \"will not return\"",
      "NFL MRI",
      "NFL torn",
      "quarterback injury",
      "NFL injured practice",
      "NFL \"blood clot\" OR hospitalized OR illness OR \"medical condition\"",
      "NFL \"held out\" OR \"will not play\" OR \"won't play\"",
      "NFL \"designated to return\" OR activated OR \"cleared to return\""
    ],
    "nba": [
      "NBA injury",
      "NBA \"ruled out\"",
      "NBA \"won't return\" OR \"will not return\"",
      "NBA MRI",
      "NBA torn",
      "NBA \"blood clot\" OR hospitalized OR illness OR \"medical condition\"",
      "NBA \"will not play\" OR \"won't play\" OR \"out indefinitely\"",
      "NBA \"cleared to return\" OR \"set to return\""
    ],
    "mlb": [
      "MLB injury",
      "MLB \"injured list\""
    ],
    "nhl": [
      "NHL injury"
    ],
    "soccer": [
      "\"Premier League\" injury",
      "\"Champions League\" injury",
      "MLS injury"
    ]
  },

  "extra_rss_feeds": {
    "nfl": ["https://www.espn.com/espn/rss/nfl/news"],
    "nba": ["https://www.espn.com/espn/rss/nba/news"],
    "mlb": ["https://www.espn.com/espn/rss/mlb/news"],
    "nhl": ["https://www.espn.com/espn/rss/nhl/news"],
    "soccer": ["https://www.espn.com/espn/rss/soccer/news"]
  }
}
